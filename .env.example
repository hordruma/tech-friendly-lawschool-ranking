# Tech-Friendly Law School Ranking — Environment Configuration
# Copy to .env and fill in your values.
# Never commit your .env file.

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Required for the researcher.py agent
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Optional: used if you extend agents to use OpenAI models as a fallback
# https://platform.openai.com
OPENAI_API_KEY=

# ── Tavily (web search for research agent) ──────────────────────────────────
# Required for the researcher.py agent's web search functionality
# https://tavily.com
TAVILY_API_KEY=

# ── TypeDB ──────────────────────────────────────────────────────────────────
# Required for typedb/ingest.py and any TypeDB-powered queries
# Default values below work for a local TypeDB instance
TYPEDB_HOST=localhost
TYPEDB_PORT=1729
TYPEDB_DATABASE=lawschools

# ── Next.js web app (optional) ──────────────────────────────────────────────
# Set if running the web app against a TypeDB backend rather than flat JSON
# NEXT_PUBLIC_TYPEDB_HTTP_URL=http://localhost:8729
